<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is deliberately off; see docs/adr/0005-distribution.md.
	     Hardened Runtime is on, so the capabilities below must be declared. -->

	<!-- AVFoundation capture of a USB-connected iOS device (MirrorKit DeviceSource).
	     Verified to be load-bearing: a hardened build signed without this key is
	     denied and lands in the "Camera access is off" state. See issue #71. -->
	<key>com.apple.security.device.camera</key>
	<true/>

	<!-- com.apple.security.automation.apple-events was here for the Keynote
	     converter, removed in #79. Nothing sends Apple Events now. It was also
	     measured not to be checked on the send path anyway (#71). -->
</dict>
</plist>
